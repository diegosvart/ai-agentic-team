# Sin ANTHROPIC_API_KEY el servidor arranca en modo simulacion (LLM mock determinista).
ANTHROPIC_API_KEY=
# LLM_MODE=mock fuerza el modo simulacion aunque exista una API key.
LLM_MODE=
MODEL_OPUS=claude-opus-5-5
MODEL_SONNET=claude-sonnet-5-5
PORT=8787
DB_PATH=./data/agentic-office.db
# Retardo artificial (ms) entre pasos del modo simulacion, para que la oficina se anime.
MOCK_STEP_DELAY_MS=900
# Origenes externos que pueden usar la API (separados por coma). El mismo origen siempre se admite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
